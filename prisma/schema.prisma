generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// =====================================================
// USER
// =====================================================

model User {
  id                String   @id @default(uuid())
  email             String   @unique
  username          String?  @unique
  passwordHash      String
  name              String
  studentId         String   @unique
  department        String
  year              String
  phone             String?
  avatar            String?
  bio               String?

  isVerified        Boolean  @default(false)
  role              String   @default("STUDENT")

  rating            Float    @default(5.0)
  ratingCount       Int      @default(0)

  totalSavings      Float    @default(0)
  wasteAvoidedKg    Float    @default(0)
  carbonSavedKg     Float    @default(0)
  itemsReusedCount  Int      @default(0)
  communityCredits  Int      @default(50)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  items                 Item[]             @relation("UserItems")
  borrowRequests        BorrowRequest[]    @relation("BorrowerRequests")
  lenderRequests        BorrowRequest[]    @relation("LenderRequests")
  reviewsGiven          Review[]           @relation("Reviewer")
  reviewsReceived       Review[]           @relation("Reviewee")
  favorites             Favorite[]
  notifications         Notification[]
  sentMessages          Message[]          @relation("SentMessages")
  borrowerConversations Conversation[]      @relation("BorrowerConversations")
  ownerConversations    Conversation[]      @relation("OwnerConversations")
  reportsSubmitted      Report[]           @relation("Reporter")
  reportsReceived       Report[]           @relation("ReportedUser")
  userAchievements      UserAchievement[]
  searchHistories       SearchHistory[]
  impactRecords         ImpactRecord[]
  adminActions          AdminAction[]      @relation("AdminActions")
  recommendations       Recommendation[]
}

// =====================================================
// CATEGORY
// =====================================================

model Category {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  icon        String
  description String

  items       Item[]

  createdAt   DateTime @default(now())
}

// =====================================================
// ITEM
// =====================================================

model Item {
  id                 String   @id @default(uuid())

  title              String
  description        String

  categoryId         String
  category           Category @relation(fields: [categoryId], references: [id])

  condition          String   @default("GOOD")

  pricePerDay        Float    @default(0)
  securityDeposit    Float    @default(0)

  pickupLocation     String
  pickupInstructions String?
  rules              String?

  maxDurationDays    Int      @default(7)

  isAvailable        Boolean  @default(true)
  isApproved         Boolean  @default(true)

  ownerId            String
  owner              User     @relation("UserItems", fields: [ownerId], references: [id], onDelete: Cascade)

  image              String
  extraImages        String?

  rating             Float    @default(5.0)
  ratingCount        Int      @default(0)

  viewsCount         Int      @default(0)
  borrowsCount       Int      @default(0)

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  borrowRequests     BorrowRequest[]
  availability       ItemAvailability[]
  reviews            Review[]
  favorites          Favorite[]
  conversations      Conversation[]
  reports            Report[]
}

// =====================================================
// ITEM AVAILABILITY
// =====================================================

model ItemAvailability {
  id          String   @id @default(uuid())

  itemId      String
  item        Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  startDate   DateTime
  endDate     DateTime

  status      String   @default("AVAILABLE")

  createdAt   DateTime @default(now())

  @@index([itemId, startDate, endDate])
}

// =====================================================
// BORROW REQUEST
// =====================================================

model BorrowRequest {
  id               String   @id @default(uuid())

  itemId           String
  item             Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  borrowerId       String
  borrower         User     @relation("BorrowerRequests", fields: [borrowerId], references: [id], onDelete: Cascade)

  ownerId          String
  owner            User     @relation("LenderRequests", fields: [ownerId], references: [id], onDelete: Cascade)

  startDate        DateTime
  endDate          DateTime

  totalDays        Int

  estimatedCost    Float
  securityDeposit  Float

  purpose          String?
  message          String?

  status           String   @default("REQUESTED")

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  transaction      BorrowTransaction?
  reviews          Review[]
  returnRecord     ReturnRecord?

  @@index([itemId, startDate, endDate])
  @@index([borrowerId])
  @@index([ownerId])
}

// =====================================================
// BORROW TRANSACTION
// =====================================================

model BorrowTransaction {
  id               String        @id @default(uuid())

  borrowRequestId  String        @unique
  borrowRequest    BorrowRequest @relation(fields: [borrowRequestId], references: [id], onDelete: Cascade)

  borrowedAt       DateTime?
  dueDate          DateTime?

  returnedAt       DateTime?

  totalAmount      Float         @default(0)
  securityDeposit  Float         @default(0)

  status           String        @default("PENDING")

  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

// =====================================================
// RETURN RECORD
// =====================================================

model ReturnRecord {
  id               String        @id @default(uuid())

  borrowRequestId  String        @unique
  borrowRequest    BorrowRequest @relation(fields: [borrowRequestId], references: [id], onDelete: Cascade)

  beforeImages     String?
  afterImages      String?

  borrowerNotes    String?
  ownerNotes       String?

  conditionStatus  String?
  damageReported   Boolean       @default(false)

  requestedAt      DateTime?
  confirmedAt      DateTime?

  createdAt        DateTime      @default(now())
}

// =====================================================
// CONVERSATION
// =====================================================

model Conversation {
  id           String    @id @default(uuid())

  itemId       String?
  item         Item?     @relation(fields: [itemId], references: [id], onDelete: SetNull)

  borrowerId   String
  borrower     User      @relation("BorrowerConversations", fields: [borrowerId], references: [id], onDelete: Cascade)

  ownerId      String
  owner        User      @relation("OwnerConversations", fields: [ownerId], references: [id], onDelete: Cascade)

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  messages     Message[]
}

// =====================================================
// MESSAGE
// =====================================================

model Message {
  id             String       @id @default(uuid())

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  senderId       String
  sender         User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  text           String
  isRead         Boolean      @default(false)

  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

// =====================================================
// NOTIFICATION
// =====================================================

model Notification {
  id        String   @id @default(uuid())

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  title     String
  message   String

  type      String   @default("SYSTEM")

  link      String?
  isRead    Boolean  @default(false)

  createdAt DateTime @default(now())

  @@index([userId, isRead])
}

// =====================================================
// REVIEW
// =====================================================

model Review {
  id              String        @id @default(uuid())

  borrowRequestId String
  borrowRequest   BorrowRequest @relation(fields: [borrowRequestId], references: [id], onDelete: Cascade)

  reviewerId      String
  reviewer        User          @relation("Reviewer", fields: [reviewerId], references: [id], onDelete: Cascade)

  revieweeId      String
  reviewee        User          @relation("Reviewee", fields: [revieweeId], references: [id], onDelete: Cascade)

  itemId          String
  item            Item          @relation(fields: [itemId], references: [id], onDelete: Cascade)

  rating          Int
  comment         String?

  createdAt       DateTime      @default(now())

  @@index([revieweeId])
  @@index([itemId])
}

// =====================================================
// FAVORITE
// =====================================================

model Favorite {
  id        String   @id @default(uuid())

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  itemId    String
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, itemId])
}

// =====================================================
// REPORT
// =====================================================

model Report {
  id             String   @id @default(uuid())

  reporterId     String
  reporter       User     @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)

  reportedUserId String?
  reportedUser   User?    @relation("ReportedUser", fields: [reportedUserId], references: [id], onDelete: SetNull)

  reportedItemId String?
  reportedItem   Item?    @relation(fields: [reportedItemId], references: [id], onDelete: SetNull)

  reason         String
  description    String

  status         String   @default("PENDING")

  createdAt      DateTime @default(now())
}

// =====================================================
// DISPUTE
// =====================================================

model Dispute {
  id              String   @id @default(uuid())

  borrowRequestId String
  reason          String
  description     String

  status          String   @default("OPEN")

  resolution      String?

  createdAt       DateTime @default(now())
  resolvedAt      DateTime?
}

// =====================================================
// ACHIEVEMENTS
// =====================================================

model Achievement {
  id           String            @id @default(uuid())

  code         String            @unique
  title        String
  description  String
  icon         String

  metricTarget Int               @default(1)

  users        UserAchievement[]
}

model UserAchievement {
  id            String      @id @default(uuid())

  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  achievementId String
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  unlockedAt    DateTime    @default(now())

  @@unique([userId, achievementId])
}

// =====================================================
// SEARCH HISTORY
// =====================================================

model SearchHistory {
  id        String   @id @default(uuid())

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  query     String
  category  String?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// =====================================================
// RECOMMENDATIONS
// =====================================================

model Recommendation {
  id          String   @id @default(uuid())

  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  itemId      String

  score       Float
  reason      String?

  createdAt   DateTime @default(now())

  @@index([userId, score])
}

// =====================================================
// SUSTAINABILITY / IMPACT
// =====================================================

model ImpactRecord {
  id              String   @id @default(uuid())

  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  borrowRequestId String?

  moneySaved      Float    @default(0)
  wasteAvoidedKg  Float    @default(0)
  carbonSavedKg   Float    @default(0)

  createdAt       DateTime @default(now())

  @@index([userId, createdAt])
}

// =====================================================
// ADMIN ACTIONS
// =====================================================

model AdminAction {
  id          String   @id @default(uuid())

  adminId     String
  admin       User     @relation("AdminActions", fields: [adminId], references: [id], onDelete: Cascade)

  action      String
  targetType  String?
  targetId    String?
  description String?

  createdAt   DateTime @default(now())

  @@index([adminId, createdAt])
}